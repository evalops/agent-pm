# Slack bot token (xoxb-...) — from "OAuth & Permissions" in your Slack app
SLACK_BOT_TOKEN=xoxb-...
# Slack app-level token (xapp-...) with connections:write — required for Socket Mode
SLACK_APP_TOKEN=xapp-...

# OpenAI API key used by the pi agent
OPENAI_API_KEY=sk-...

# GitHub token with permission to create issues in GITHUB_REPO
GITHUB_TOKEN=ghp_...
# Repository to file issues in, as "owner/name"
GITHUB_REPO=evalops/agent-pm

# When true, no GitHub issues are created; the Slack reply shows the issue
# payloads that WOULD be filed. Defaults to true — set to false explicitly to
# enable issue creation.
DRY_RUN=true

# OpenAI model used by the agent (default: gpt-4o-mini)
MODEL=gpt-4o-mini
