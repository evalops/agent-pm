# Slack bot token (xoxb-...) — from "OAuth & Permissions" in your Slack app
SLACK_BOT_TOKEN=xoxb-...
# Slack app-level token (xapp-...) with connections:write — required for Socket Mode
SLACK_APP_TOKEN=xapp-...

# LLM provider for the pi agent: openai (default) | anthropic | google
PROVIDER=openai
# API key for the chosen provider (only the matching one is required):
#   openai    -> OPENAI_API_KEY
#   anthropic -> ANTHROPIC_API_KEY
#   google    -> GEMINI_API_KEY
OPENAI_API_KEY=sk-...

# Model used by the agent. Defaults per provider:
#   openai: gpt-4o-mini, anthropic: claude-sonnet-4-6, google: gemini-2.5-flash
MODEL=gpt-4o-mini

# Abort an agent run after this many milliseconds (default: 180000)
AGENT_TIMEOUT_MS=180000

# GitHub token with permission to create issues in GITHUB_REPO
GITHUB_TOKEN=ghp_...
# Repository to file issues in, as "owner/name"
GITHUB_REPO=evalops/agent-pm

# Global safety override on top of per-PRD approval. When true (default),
# approved drafts only produce would-be issue payloads in the thread; no real
# issues are created. Set to false explicitly to enable issue creation.
DRY_RUN=true
